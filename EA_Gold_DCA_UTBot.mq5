#include <Trade\Trade.mqh>
#include <Calendar\Calendar.mqh>

enum OscillatorMode
  {
   OSC_RSI = 0,
   OSC_CCI = 1
  };

input string          InpStrategyTag                = "Gold_DCA_UTBot";
input ulong           InpMagicNumber                = 5102025;
input double          InpInitialLot                 = 0.10;
input double          InpLotMultiplier              = 1.50;
input double          InpStepPoints                 = 500.0;
input uint            InpMaxPositionsPerSide        = 6;
input bool            InpUseOnlyNewBarSignals       = true;
input int             InpSlippage                   = 30;

input ENUM_TIMEFRAMES InpSignalTF                   = PERIOD_M15;
input int             InpFastEMA                    = 34;
input int             InpSlowEMA                    = 89;

input bool            InpUseTrendFilter             = true;
input ENUM_TIMEFRAMES InpTrendTF                    = PERIOD_H1;
input int             InpTrendFastEMA               = 55;
input int             InpTrendSlowEMA               = 144;

input bool            InpUseOscillatorFilter        = true;
input OscillatorMode  InpOscillatorMode             = OSC_RSI;
input int             InpRSIPeriod                  = 14;
input int             InpCCIPeriod                  = 20;
input double          InpOscillatorBuyLevel         = 55.0;
input double          InpOscillatorSellLevel        = 45.0;

input int             InpUTAtrPeriod                = 10;
input double          InpUTAtrMultiplier            = 1.5;

input double          InpBasketTakeProfitUSD        = 8.0;
input double          InpBasketTrailingStartUSD     = 5.0;
input double          InpBasketTrailingLockUSD      = 3.0;
input double          InpBasketQuickCloseUSD        = 1.0;

input bool            InpEnableHedging              = true;
input double          InpHedgeMarginLevel           = 140.0;
input uint            InpHedgeCooldownMinutes       = 15;

input bool                    InpUseNewsFilter      = true;
input ENUM_CALENDAR_IMPORTANCE InpNewsMinImpact     = CALENDAR_IMPORTANCE_HIGH;
input uint                    InpNewsMinutesBefore  = 30;
input uint                    InpNewsMinutesAfter   = 30;
input bool                    InpNewsBlockBuys      = true;
input bool                    InpNewsBlockSells     = true;
input bool                    InpAllowDcaDuringNews = false;
input bool                    InpAllowHedgeDuringNews = true;

//--- constants & globals
const int             DIR_BUY                       = 1;
const int             DIR_SELL                      = -1;

CTrade                trade;

datetime              g_lastSignalBarTime           = 0;
int                   g_pendingDirection            = 0;

double                g_utFinalUpper                = 0.0;
double                g_utFinalLower                = 0.0;
int                   g_utTrend                     = 0;
bool                  g_utInitialized               = false;

datetime              g_lastHedgeTimeBuy            = 0;
datetime              g_lastHedgeTimeSell           = 0;

int                   g_handleATR                   = INVALID_HANDLE;
int                   g_handleEMAfast               = INVALID_HANDLE;
int                   g_handleEMAslow               = INVALID_HANDLE;
int                   g_handleRSI                   = INVALID_HANDLE;
int                   g_handleCCI                   = INVALID_HANDLE;
int                   g_handleTrendEMAfast          = INVALID_HANDLE;
int                   g_handleTrendEMAslow          = INVALID_HANDLE;

double                g_trailingLockUsd             = 0.0;
string                g_symbolBase                  = "";
string                g_symbolQuote                 = "";
bool                  g_calendarReady               = false;

//--- function declarations
bool     IsSymbolReady();
